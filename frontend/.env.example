# ═══════════════════════════════════════════════════
# SignalFlow Studio — safe environment configuration
# ═══════════════════════════════════════════════════
# 1. Never prefix provider secrets or OAuth credentials with NEXT_PUBLIC_.
# 2. Never commit .env.local or real credentials.
# 3. Keep public hosted instances owner-locked.
# 4. Prefer one strong SIGNALFLOW_ACCESS_KEY (32+ chars) where runtime signing secrets
#    can be derived safely instead of duplicating equivalent secrets.

# App security and canonical origin
SIGNALFLOW_ACCESS_KEY=
SIGNALFLOW_PUBLIC_HOSTED=true
# Personal Alpha uses one canonical workspace identity. Future hosted multi-tenant auth
# must derive this server-side from the authenticated workspace instead of a global env value.
SIGNALFLOW_WORKSPACE_ID=owner-local
# Vercel production can derive the canonical origin automatically; set this explicitly
# for local/other hosted environments or when a fixed canonical URL is required.
NEXTAUTH_URL=https://signal-flow-studio.vercel.app
SOCIAL_ENCRYPTION_KEY=

# Durable connected-source ingestion
# Server-side Postgres/Neon connection string. Never expose this to the browser.
DATABASE_URL=

# Private immutable Asset storage
# Personal Alpha can use the Postgres/Neon private-blob fallback, so external object
# storage is optional. Configure these only when moving larger Asset payloads to an
# S3-compatible private store.
SIGNALFLOW_S3_ENDPOINT=
SIGNALFLOW_S3_BUCKET=
SIGNALFLOW_S3_REGION=auto
SIGNALFLOW_S3_ACCESS_KEY_ID=
SIGNALFLOW_S3_SECRET_ACCESS_KEY=
# Optional for temporary/role credentials.
SIGNALFLOW_S3_SESSION_TOKEN=
# Optional metadata label stored in canonical storage references.
SIGNALFLOW_S3_PROVIDER=s3-compatible
# Optional explicit HMAC override for exact-media preview receipts. When omitted,
# a strong SIGNALFLOW_ACCESS_KEY is used to derive a domain-separated receipt secret.
SIGNALFLOW_MEDIA_PREVIEW_RECEIPT_SECRET=

# Bounded hosted browser capture + deterministic screenshot derivative processing
# Server-only WSS endpoint for the approved remote CDP browser worker. The same
# controlled browser runtime is currently used for screenshot decode/crop/resize.
# Do not put browser credentials in URL userinfo; keep endpoint access server-only.
SIGNALFLOW_CDP_BROWSER_WS_ENDPOINT=
# Optional server-only bearer token for CDP providers that authenticate the WebSocket
# handshake with Authorization: Bearer <token> (for example Cloudflare Browser Run).
# Never append this value to the WebSocket URL or expose it to browser code.
SIGNALFLOW_CDP_BROWSER_AUTH_TOKEN=
# Must match the allowedEnvironment of the CaptureRecipe used by the hosted GP2 path.
SIGNALFLOW_CAPTURE_ENVIRONMENT=preview
# Development-only escape hatch for ws://localhost/127.0.0.1. Remote workers still require WSS.
SIGNALFLOW_CAPTURE_ALLOW_INSECURE_LOCALHOST=false

# GitHub source connection — preferred manifest mode
# Do NOT pre-create or paste GitHub App private keys, OAuth client secrets, or webhook
# secrets for the normal hosted setup. SignalFlow creates the private GitHub App through
# GitHub's manifest flow and stores returned authority encrypted in sf_secret_records.
# A strong SIGNALFLOW_ACCESS_KEY can derive both install-state and credential-vault
# signing/encryption keys. These explicit overrides are only needed when you deliberately
# want independent key rotation or cannot use a strong owner root.
GITHUB_INSTALL_STATE_SECRET=
SIGNALFLOW_CREDENTIAL_VAULT_SECRET=

# Legacy GitHub App fallback only
# Keep these empty when using manifest provisioning. They remain supported so an existing
# manually-managed GitHub App can still be operated without changing the source contract.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# AI model providers (owner/private deployments)
# Vercel deployments may use Vercel AI Gateway/OIDC without a separate provider key.
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# LinkedIn
# Callback: ${NEXTAUTH_URL}/api/social/callback/linkedin
# Scopes/products: openid, profile, w_member_social; OIDC Sign In; Share on LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202607

# X OAuth 2.0 with PKCE
# Callback: ${NEXTAUTH_URL}/api/social/callback/x
# Scopes: tweet.read, tweet.write, users.read, offline.access
# Current X API access is pay-per-use; fund credits and set a spending limit in the Developer Console.
X_CLIENT_ID=
X_CLIENT_SECRET=

# Reddit Data API web app
# Callback: ${NEXTAUTH_URL}/api/social/callback/reddit
# Scopes: identity, submit, read
# Explicit Data API approval is required under Reddit's Responsible Builder Policy.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Example format: web:signalflow-studio:0.2.0 (by /u/your_reddit_username)
REDDIT_USER_AGENT=

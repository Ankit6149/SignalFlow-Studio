    {
      "@type": "FAQPage",
      "@id": "https://signal-flow-studio.vercel.app/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is SignalFlow?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "SignalFlow is an approval-first content operating system designed to reduce the operational work between meaningful work and audience communication while keeping judgment, explicit boundaries, and exact approval with the user."
          }
        },
        {
          "@type": "Question",
          "name": "What can I use SignalFlow for today?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The accepted owner path can capture manual Signals, evaluate opportunities, plan a narrative, create exact LinkedIn and X revisions, apply evidence and authenticity checks, and support exact owner review. Hosted GitHub/source, project-context, planning, review, job-state, and private-asset foundations also exist when configured, while the complete GitHub-to-automatic-evidence Golden Path is still under acceptance."
          }
        },
        {
          "@type": "Question",
          "name": "Does SignalFlow publish without approval?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Approval is bound to an exact visible revision. A changed or regenerated revision requires judgment again, and external publication success is not claimed until a destination confirms it."
          }
        },
        {
          "@type": "Question",
          "name": "Where is current state stored?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Manual Campaigns remain browser-local. Configured hosted owner workflows also use durable Postgres-backed record families for connected sources, Signals, ProjectContext, Opportunities, planning, review, opportunity-job state, and private Assets. Those hosted records do not imply general cloud Campaign autosave, cross-device Campaign sync, or collaboration."
          }
        },
        {
          "@type": "Question",
          "name": "Can I bring my own model provider?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "SignalFlow supports configured hosted, bring-your-own, local, and compatible custom model routes where the active deployment and privacy policy allow them. Runtime capability discovery determines what is available to a session."
          }
        }
      ]
    }
  ]
}

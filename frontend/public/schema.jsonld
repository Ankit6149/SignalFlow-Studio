    {
      "@type": "FAQPage",
      "@id": "https://signal-flow-studio.vercel.app/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What can I use SignalFlow Studio for today?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The current Studio turns manual source context such as notes, supported links, repository context, and supported text files into editable destination drafts through a real model route. Drafts stay reviewable, recoverable in the current browser, and exportable."
          }
        },
        {
          "@type": "Question",
          "name": "What is SignalFlow becoming?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "SignalFlow is being built as an approval-first content operating system: a layer that can turn meaningful work and source evidence into worthwhile content opportunities, production plans, reviewable content, durable publication, and narrative memory as those capabilities are implemented."
          }
        },
        {
          "@type": "Question",
          "name": "Does SignalFlow publish without approval?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Every current draft stays reviewable. Direct publishing is only offered when an official connector is configured and the platform API confirms success."
          }
        },
        {
          "@type": "Question",
          "name": "Where are campaigns and account tokens stored?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Saved campaigns remain in the current browser. Social OAuth tokens are encrypted in HTTP-only cookies and are not exposed to page JavaScript."
          }
        },
        {
          "@type": "Question",
          "name": "Can I bring my own model provider?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. SignalFlow supports configured Gemini, OpenAI, Claude, OpenRouter, Groq, Ollama, LM Studio, and compatible custom endpoints where the active deployment and session can reach them. Campaign generation requires a real model route."
          }
        }
      ]
    }
  ]

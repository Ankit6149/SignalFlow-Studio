    {
      "@type": "FAQPage",
      "@id": "https://signal-flow-studio.vercel.app/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What does SignalFlow Studio actually create?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It turns product notes, public links, repository context, and supported text files into editable drafts for social, community, video, newsletter, blog, and release-note channels."
          }
        },
        {
          "@type": "Question",
          "name": "Does SignalFlow publish without approval?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Every draft stays reviewable. Direct publishing is only offered when an official connector is configured and the platform API confirms success."
          }
        },
        {
          "@type": "Question",
          "name": "Which platforms can publish directly?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "LinkedIn, X, and Reddit have official OAuth connector paths in the current release. Other destinations use a clear copy, export, and open-platform workflow."
          }
        },
        {
          "@type": "Question",
          "name": "Where are campaigns and account tokens stored?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Saved campaigns remain in versioned records in the current browser. Social OAuth tokens are encrypted in HTTP-only cookies and are not exposed to page JavaScript."
          }
        },
        {
          "@type": "Question",
          "name": "Which model routes can I use?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Campaign generation requires a real model route available to the current deployment and session. Supported adapters include Gemini, OpenAI, Claude, OpenRouter, Groq, Ollama, LM Studio, and compatible custom endpoints."
          }
        }
      ]
    }
